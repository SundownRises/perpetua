{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "hardhat.config.ts",
    "addresses.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "artifacts/**/*.d.ts"
  ]
}
